{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "DUID",
            "caption": "Device ID (DUID, filled in by the configurator)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update interval",
            "suffix": "s",
            "minimum": 30
        },
        {
            "type": "NumberSpinner",
            "name": "CleaningInterval",
            "caption": "Update interval while cleaning",
            "suffix": "s",
            "minimum": 30
        },
        {
            "type": "CheckBox",
            "name": "ShowRooms",
            "caption": "Room selection (one switch per room of the map)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Rooms",
            "items": [
                {
                    "type": "Label",
                    "caption": "Own names (empty = name from the Roborock app) and which rooms are shown. Rooms are read with \"Reload rooms\"."
                },
                {
                    "type": "List",
                    "name": "RoomSettings",
                    "caption": "Rooms",
                    "rowCount": 8,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "Segment",
                            "name": "segment",
                            "width": "90px"
                        },
                        {
                            "caption": "Name in the app",
                            "name": "app",
                            "width": "200px"
                        },
                        {
                            "caption": "Own name",
                            "name": "name",
                            "width": "auto",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Show",
                            "name": "show",
                            "width": "90px",
                            "edit": {
                                "type": "CheckBox"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "ShowConsumables",
            "caption": "Consumables (main brush, side brush, filter, sensors)"
        },
        {
            "type": "CheckBox",
            "name": "ShowStatistics",
            "caption": "Cleaning statistics (total area, total time, number of cleanings)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Status tile",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ShowTile",
                    "caption": "Create status tile (HTML variable for the tile visualization)"
                },
                {
                    "type": "Select",
                    "name": "TileTheme",
                    "caption": "Design",
                    "options": [
                        {
                            "caption": "Automatic (design of the visualization)",
                            "value": 0
                        },
                        {
                            "caption": "Dark",
                            "value": 1
                        },
                        {
                            "caption": "Light",
                            "value": 2
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Cleaning tile",
            "items": [
                {
                    "type": "Label",
                    "caption": "Link this instance in the tile visualization: map in the middle, commands and room selection on the left, state, statistics and maintenance on the right."
                },
                {
                    "type": "SelectObject",
                    "name": "MapVariable",
                    "caption": "Map (optional: HTML box with an image of the map, or image)"
                },
                {
                    "type": "Select",
                    "name": "MapRotation",
                    "caption": "Rotate map",
                    "options": [
                        {
                            "caption": "0°",
                            "value": 0
                        },
                        {
                            "caption": "90°",
                            "value": 90
                        },
                        {
                            "caption": "180°",
                            "value": 180
                        },
                        {
                            "caption": "270°",
                            "value": 270
                        }
                    ]
                },
                {
                    "type": "SelectMedia",
                    "name": "RobotImage",
                    "caption": "Picture of the robot (optional, image)"
                },
                {
                    "type": "Select",
                    "name": "RobotArt",
                    "caption": "Illustration (if no picture is selected)",
                    "options": [
                        {
                            "caption": "Automatic (from the functions of the robot)",
                            "value": 0
                        },
                        {
                            "caption": "Robot with multifunction station",
                            "value": 1
                        },
                        {
                            "caption": "Robot with auto-empty dock",
                            "value": 2
                        },
                        {
                            "caption": "Robot with charging dock",
                            "value": 3
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Update now",
                    "onClick": "RRV_Update($id);"
                },
                {
                    "type": "Button",
                    "caption": "Reload rooms",
                    "onClick": "echo RRV_LoadRooms($id);"
                },
                {
                    "type": "Button",
                    "caption": "Locate robot",
                    "onClick": "RRV_Locate($id);"
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "inactive",
            "caption": "No device ID configured, please create the instance with the configurator"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Request failed, see debug output"
        }
    ]
}
